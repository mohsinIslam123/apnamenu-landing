---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import MachineBand from '../components/MachineBand.jsx';
import OfferStrip from '../components/OfferStrip.jsx';
import OfferCard from '../components/OfferCard.jsx';
import FaqList from '../components/FaqList.jsx';
import '../index.css';
import '../styles/machine.css';
import '../styles/machine-m.css';
import '../styles/business.css';
import '../styles/inner.css';

const title = 'Restaurant POS Pricing in India | Zipla POS';
const description = 'See Zipla POS pricing for Indian restaurants, cafes, QSRs, bakeries, sweet shops and dhabas: ₹4,999/year or ₹11,999 for 3 years prepaid, with a 14-day free trial.';
const canonical = 'https://zipla.in/pricing/';

const faqs = [
  {
    question: 'How much does Zipla POS cost?',
    answer: 'The Zipla POS Complete plan costs ₹4,999 per year or ₹11,999 for a 3-year prepaid term.',
  },
  {
    question: 'Is there a free trial?',
    answer: 'Yes. Zipla POS offers a 14-day free trial with no credit card required to start.',
  },
  {
    question: 'What is included in the Complete plan?',
    answer: 'The Complete plan includes counter billing, configured GST invoices, payment tracking, inventory with low-stock alerts, staff roles, KDS, table QR ordering, Bluetooth KOT auto-print, sales analytics and day-close reports.',
  },
  {
    question: 'Can I test Zipla POS with my own menu?',
    answer: 'Yes. Use the trial to add a small version of your own menu, create a bill, mark a payment mode and test the kitchen or QR workflow when it is relevant to your outlet.',
  },
  {
    question: 'Does offline billing work without internet?',
    answer: 'After the menu has loaded, bills can be created without an active internet connection. UPI and other online payments require connectivity.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://zipla.in/#website' },
      about: { '@id': 'https://zipla.in/#software' },
      inLanguage: 'en-IN',
      dateModified: '2026-09-22',
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://zipla.in/' },
        { '@type': 'ListItem', position: 2, name: 'Pricing', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<Layout zp title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Header client:load />

  <main class="zb-page">
    <nav class="zb-wrap zb-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><span>Pricing</span>
    </nav>

    <section class="zb-wrap zb-hero zb-hero--solo" aria-labelledby="pricing-page-title">
      <div class="zb-hero-top">
        <span class="zb-eyebrow"><span class="zb-dot" aria-hidden="true"></span>Zipla POS pricing for India</span>
        <h1 id="pricing-page-title" class="zb-h1">Restaurant POS <span class="zb-hl">Pricing</span> in India</h1>
        <p class="zb-lede"><strong>Key takeaway:</strong> The Zipla POS Complete plan costs ₹4,999 per year or ₹11,999 for 3 years prepaid, with a 14-day free trial and no credit card required.</p>
        <p class="zb-lede"><strong>In plain language:</strong> Restaurant POS and billing software helps a food business create customer bills, apply configured GST rules, record payments and connect relevant ordering or kitchen workflows.</p>
        <div class="zb-btnrow">
          <a class="zb-btn zb-btn-gold zb-btn-lg" href="https://app.zipla.in/register">Start 14-Day Free Trial</a>
          <a class="zb-btn zb-btn-ghost zb-btn-lg" href="/#demo">Book Free WhatsApp Demo</a>
        </div>
        <p class="zi-dateline"><strong>Last reviewed:</strong> <time datetime="2026-09-22">22 September 2026</time>. Plan details on this page reflect the current Zipla POS landing copy.</p>
      </div>
      <MachineBand seePricing={false} />
    </section>

    <OfferStrip />
    <OfferCard />

    <section id="complete-plan" class="zb-sec zb-band" aria-labelledby="complete-plan-title">
      <div class="zb-wrap zb-cols">
        <div>
          <span class="zb-kicker">One plan, clear terms</span>
          <h2 id="complete-plan-title" class="zb-h2">The Complete plan for your service workflow</h2>
          <p class="zb-sec-p">Choose the Complete plan when your outlet needs counter billing first and may also need QR ordering, kitchen handoff, printing or owner review. Use the trial with your own menu before committing.</p>
          <ul class="zb-chk">
            <li>Counter POS billing and configured GST invoices</li>
            <li>Cash, UPI and card payment tracking</li>
            <li>Inventory with low-stock alerts and staff roles</li>
            <li>Table QR ordering and Customer QR Home Ordering</li>
            <li>Kitchen Display System and Bluetooth KOT auto-print</li>
            <li>Sales analytics and day-close reports</li>
          </ul>
        </div>

        <div class="zi-pcard" aria-label="Zipla POS Complete plan price">
          <div class="zi-pslip">
            <span class="zi-ptitle">Complete plan</span>
            <div class="zi-prule" aria-hidden="true"></div>
            <div class="zi-pbig"><span class="zi-pnum">₹4,999</span> <small class="zi-punit">/ year</small></div>
            <div class="zi-prule" aria-hidden="true"></div>
            <p class="zi-prow"><strong>₹11,999</strong> for 3 years prepaid</p>
            <div class="zi-prule" aria-hidden="true"></div>
            <p class="zi-pnote">14-day free trial · No credit card required</p>
            <div class="zi-pcta">
              <a class="zb-btn zb-btn-gold zi-btn-md" href="https://app.zipla.in/register">Start the free trial</a>
              <a class="zb-btn zb-btn-ghost zi-btn-md" href="/#demo">Talk through your workflow on WhatsApp →</a>
            </div>
          </div>
          <div class="zi-pzig" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="zb-sec" aria-labelledby="pricing-terms-title">
      <div class="zb-wrap">
        <header class="zb-head">
          <span class="zb-kicker">Current terms</span>
          <h2 id="pricing-terms-title" class="zb-h2">What does Zipla POS pricing include?</h2>
          <p class="zb-sec-p">Use this at-a-glance summary when comparing billing software for an Indian food business. Confirm the workflow during the trial before making a purchase decision.</p>
        </header>
        <div class="zb-table-wrap">
          <table class="zb-wf zb-wf--3 zi-wf-text">
            <caption class="zi-caption">Current Zipla POS pricing and onboarding terms</caption>
            <thead>
              <tr><th scope="col">Item</th><th scope="col">Current term</th><th scope="col">How to evaluate it</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Complete plan</th><td>₹4,999 per year</td><td>Review counter billing, configured GST invoices and payment tracking.</td></tr>
              <tr><th scope="row">3-year prepaid</th><td>₹11,999</td><td>Choose this term only after testing the workflow with your own menu.</td></tr>
              <tr><th scope="row">Free trial</th><td>14 days; no credit card</td><td>Create a real sample bill and test the relevant QR or kitchen workflow.</td></tr>
              <tr><th scope="row">Optional on-site onboarding</th><td>₹1,999 separately</td><td>Confirm the current scope before purchase; it is separate from the software plan.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="zb-sec zb-band" aria-labelledby="pricing-fit-title">
      <div class="zb-wrap">
        <header class="zb-head">
          <span class="zb-kicker">Check fit before purchase</span>
          <h2 id="pricing-fit-title" class="zb-h2">What should you test during the trial?</h2>
          <p class="zb-sec-p">Pricing is only useful when the workflow fits your outlet. Test the steps your team actually performs during service.</p>
        </header>
        <ol class="zb-steps" aria-label="Four trial checks">
          <li class="zb-steps-i"><span class="zb-steps-n">01</span><h3 class="zb-steps-h">Your menu</h3><p class="zb-steps-p">Add familiar items, prices and categories instead of judging the workflow only from a sample screen.</p></li>
          <li class="zb-steps-i"><span class="zb-steps-n">02</span><h3 class="zb-steps-h">One customer bill</h3><p class="zb-steps-p">Create a bill, mark cash, UPI or card and review the invoice output before a live shift.</p></li>
          <li class="zb-steps-i"><span class="zb-steps-n">03</span><h3 class="zb-steps-h">Kitchen or QR flow</h3><p class="zb-steps-p">When relevant, test table QR ordering, Customer QR Home Ordering, KDS or Bluetooth KOT auto-print.</p></li>
          <li class="zb-steps-i"><span class="zb-steps-n">04</span><h3 class="zb-steps-h">Day-close review</h3><p class="zb-steps-p">Check the sales analytics and day-close information that the owner or manager needs after service.</p></li>
        </ol>
      </div>
    </section>

    <section class="zb-sec" aria-labelledby="pricing-audience-title">
      <div class="zb-wrap">
        <header class="zb-head">
          <span class="zb-kicker">Built for Indian food businesses</span>
          <h2 id="pricing-audience-title" class="zb-h2">Which outlets can evaluate Zipla POS?</h2>
          <p class="zb-sec-p">This page is for Indian restaurant owners and managers comparing billing software for counter service, table QR ordering, kitchen handoff, weight-based items or owner day-close review. Start with the page that matches your service model, then compare the same Complete plan and trial terms.</p>
        </header>
        <div class="zi-rows">
          <a class="zi-row" href="/restaurant-pos-software/"><strong class="zi-row-h">Restaurants</strong><span class="zi-row-p">Counter, table and kitchen workflows →</span></a>
          <a class="zi-row" href="/cafe-pos-software/"><strong class="zi-row-h">Cafés</strong><span class="zi-row-p">Counter service with seated diners →</span></a>
          <a class="zi-row" href="/qsr-billing-software/"><strong class="zi-row-h">QSRs</strong><span class="zi-row-p">Counter-led ordering and kitchen queue →</span></a>
          <a class="zi-row" href="/bakery-billing-software/"><strong class="zi-row-h">Bakeries</strong><span class="zi-row-p">Weight, piece and fixed-price items →</span></a>
          <a class="zi-row" href="/sweet-shop-billing/"><strong class="zi-row-h">Sweet shops</strong><span class="zi-row-p">Mixed weight and fixed-price bills →</span></a>
          <a class="zi-row" href="/dhaba-billing-software/"><strong class="zi-row-h">Dhabas</strong><span class="zi-row-p">Billing and day-review workflow →</span></a>
        </div>
      </div>
    </section>

    <section class="zb-sec zb-band" aria-labelledby="pricing-interface-title">
      <div class="zb-wrap zb-cols">
        <div>
          <span class="zb-kicker">See the workflow context</span>
          <h2 id="pricing-interface-title" class="zb-h2">What should you look at before choosing a plan?</h2>
          <p class="zb-sec-p">Use the product interface preview as context, then test your own menu, payment modes and relevant kitchen or QR workflow during the trial. This image is not a customer testimonial or performance guarantee.</p>
          <ul class="zb-chk">
            <li>Check whether the counter billing flow matches your staff routine.</li>
            <li>Review the kitchen, QR ordering and day-close steps that matter to your outlet.</li>
            <li>Confirm device, printer and payment requirements before purchase.</li>
          </ul>
        </div>
        <figure class="zi-fig">
          <div class="zi-panel">
            <div class="zi-pf"><img src="/images/screen-dashboard.webp" alt="Zipla POS dashboard interface showing billing, inventory, kitchen display and customer menu entry points" width="720" height="1465" loading="lazy" decoding="async" /></div>
          </div>
          <figcaption>Zipla POS product interface preview. Test the current workflow with your own menu.</figcaption>
        </figure>
      </div>
    </section>

    <section class="zb-sec" aria-labelledby="pricing-faq-title">
      <div class="zb-wrap zb-faq-wrap">
        <header class="zb-faq-l">
          <span class="zb-kicker">Pricing questions</span>
          <h2 id="pricing-faq-title" class="zb-h2">Before you start</h2>
          <p class="zi-faq-intro">Read the short answers below, or see the full <a href="/faq/">Zipla POS FAQ</a> for product and support details.</p>
        </header>
        <FaqList faqs={faqs} />
      </div>
    </section>

    <section class="ink zb-ink">
      <div class="zb-wrap zb-sec zb-demo">
        <div class="zb-demo-l"><h2 class="zb-demo-h">Test the workflow before you decide.</h2><p class="zb-demo-p">Start with a small version of your own menu, or book a WhatsApp demo around the service flow your team actually uses.</p></div>
        <div class="zb-demo-r"><a class="zb-btn zb-btn-gold zb-btn-lg zb-btn-wide" href="https://app.zipla.in/register">Start 14-Day Free Trial</a><a class="zb-btn zb-btn-ghost zb-btn-lg zb-btn-wide" href="/#demo">Book Free WhatsApp Demo</a></div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
