        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://zipla.in/" },
          { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://zipla.in/blog/" },
          { "@type": "ListItem", "position": 3, "name": "Bakery Billing Guide 2026", "item": "https://zipla.in/blog/bakery-billing-software-weight-billing-guide-2026/" }
