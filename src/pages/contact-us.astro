---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import MachineCard from '../components/MachineCard.jsx';
import FaqList from '../components/FaqList.jsx';
import '../index.css';
import '../styles/machine.css';
import '../styles/machine-m.css';
import '../styles/business.css';
import '../styles/inner.css';

const title = 'Contact Zipla POS Support | Billing Software Help';
const description = 'Contact Zipla POS support for billing software help, subscriptions, cancellations and refund requests by email, phone or WhatsApp.';
const canonical = 'https://zipla.in/contact-us/';

const contactFaqs = [
  {
    question: 'How can I contact Zipla POS support?',
    answer: 'Contact Zipla POS support at support@zipla.in, by phone or WhatsApp at +91 7817851009.',
  },
  {
    question: 'What should I include in a Zipla POS support request?',
    answer: 'Include your business name, registered phone number and a short description of the issue or request. Do not send passwords, UPI PINs or payment credentials by email or WhatsApp.',
  },
  {
    question: 'How do I request a cancellation or refund?',
    answer: 'Email support@zipla.in from your registered email address. Include your business name, registered phone number, payment date and whether you want cancellation or a refund. Read the Cancellation & Refund Policy for the applicable conditions.',
  },
  {
    question: 'Can I contact Zipla POS before starting a trial?',
    answer: 'Yes. Zipla POS trial users, customers and Indian food-business owners evaluating the service can use these support contact details for product, subscription and business enquiries.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': canonical,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://zipla.in/#website' },
      about: { '@id': 'https://zipla.in/#software' },
      inLanguage: 'en-IN',
      dateModified: '2026-09-22',
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://zipla.in/' },
        { '@type': 'ListItem', position: 2, name: 'Contact Zipla POS Support', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: contactFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<Layout zp title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Header client:load />

  <main class="zb-page">
    <article>
      <header class="zb-wrap zm-hero-m zm-hero-m--nc">
        <div class="zm-hero-top">
          <p class="zb-eyebrow"><span class="zb-dot" aria-hidden="true"></span>Zipla POS</p>
          <h1 class="zb-h1">Contact Zipla POS <span class="zb-hl">Support</span></h1>
          <p class="zi-dateline">Last updated: <time datetime="2026-09-22">September 22, 2026</time></p>
          <p class="zb-lede"><strong>Key takeaway:</strong> Contact Zipla POS support for billing software help, subscription questions, cancellation requests or refund requests.</p>
          <p class="zi-note"><strong>Who this is for:</strong> Zipla POS trial users, customers and Indian food-business owners evaluating the service. <strong>Use this page when:</strong> you need product, account, subscription, cancellation or refund help.</p>
        </div>
        <MachineCard />
      </header>

      <section class="zb-sec zb-band zi-first">
        <div class="zb-wrap">
          <p class="zb-sec-p zi-intro">A contact page gives Zipla POS users and prospective customers a direct route for product support, subscription questions, cancellations and refund requests. Use the contact details below.</p>
          <h2 class="zb-h2">How can you contact Zipla POS support?</h2>
          <p class="zi-qa"><strong>Short answer:</strong> Email <a href="mailto:support@zipla.in">support@zipla.in</a>, call <a href="tel:+917817851009">+91 7817851009</a> or WhatsApp <a href="https://wa.me/917817851009" target="_blank" rel="noopener noreferrer">+91 7817851009</a> using the verified support channels below.</p>
          <dl class="zi-crows">
            <div class="zi-crow"><dt>Business name</dt><dd>ZIPLA (Operating as Zipla POS)</dd></div>
            <div class="zi-crow"><dt>Support email</dt><dd><a href="mailto:support@zipla.in">support@zipla.in</a></dd></div>
            <div class="zi-crow"><dt>Support phone</dt><dd><a href="tel:+917817851009">+91 7817851009</a></dd></div>
            <div class="zi-crow"><dt>WhatsApp</dt><dd><a href="https://wa.me/917817851009" target="_blank" rel="noopener noreferrer">Message on WhatsApp</a></dd></div>
          </dl>
        </div>
      </section>

      <section class="zb-sec">
        <div class="zb-wrap">
          <h2 class="zb-h2">Which Zipla POS support route should you use?</h2>
          <p class="zi-qa"><strong>Short answer:</strong> Choose the route that matches your request, then include enough account information for Zipla POS to identify it safely.</p>
          <h3 class="zb-h3 zi-h3">Support request guide</h3>
          <div class="zb-table-wrap">
            <table class="zb-wf zb-wf--3 zi-wf-text zi-wf-route">
              <thead>
                <tr><th scope="col">If you need</th><th scope="col">Contact route</th><th scope="col">Include</th></tr>
              </thead>
              <tbody>
                <tr><th scope="row">Product or setup help</th><td><a href="mailto:support@zipla.in">Email</a>, <a href="tel:+917817851009">call</a> or <a href="https://wa.me/917817851009" target="_blank" rel="noopener noreferrer">WhatsApp</a></td><td>Business name, registered phone number and a short description of the billing-software question.</td></tr>
                <tr><th scope="row">Subscription, cancellation or refund</th><td><a href="mailto:support@zipla.in">support@zipla.in</a></td><td>Business name, registered phone number, payment date and the request type.</td></tr>
                <tr><th scope="row">General business enquiry</th><td><a href="mailto:support@zipla.in">Email</a>, <a href="tel:+917817851009">call</a> or <a href="https://wa.me/917817851009" target="_blank" rel="noopener noreferrer">WhatsApp</a></td><td>Your business name and the information you need before starting a trial.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="zb-sec zb-band">
        <div class="zb-wrap">
          <div class="zi-read">
            <h2 class="zb-h2">What should you include in a support request?</h2>
            <p class="zb-sec-p">Use this short checklist so Zipla POS can identify the right account or request without asking you to share sensitive credentials.</p>
            <ol class="zi-list">
              <li>State your business name and registered phone number.</li>
              <li>Describe the product, subscription, cancellation or refund request in a few sentences.</li>
              <li>For a payment request, include the payment date.</li>
              <li>Do not send passwords, UPI PINs or payment credentials by email or WhatsApp.</li>
            </ol>
            <h3 class="zb-h3 zi-h3">Example support email</h3>
            <div class="zi-mail">
              <p><strong>Subject:</strong> Help with my Zipla POS account<br />
              <strong>Include:</strong> business name, registered phone number, the request type and a short description of the issue. For a subscription, cancellation or refund request, also include the payment date.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="zb-sec">
        <div class="zb-wrap">
          <div class="zi-read">
            <h2 class="zb-h2">Need to cancel or request a refund?</h2>
            <p class="zi-qa"><strong>Short answer:</strong> Send the request to <a href="mailto:support@zipla.in">support@zipla.in</a> from your registered email address, then review the applicable conditions in the <a href="/refund-policy/">Zipla POS Cancellation &amp; Refund Policy</a>.</p>
            <p class="zb-sec-p">For information about the payment provider's own support process after you have contacted Zipla POS, use the official <a href="https://razorpay.com/support/" target="_blank" rel="noopener noreferrer">Razorpay Support</a> page. Zipla subscription, cancellation and refund requests should start with Zipla POS support.</p>
          </div>
        </div>
      </section>

      <section class="zb-sec zb-band" aria-labelledby="contact-faq-title">
        <div class="zb-wrap">
          <h2 id="contact-faq-title" class="zb-h2">Zipla POS Support FAQs</h2>
          <p class="zb-sec-p">Concise answers for trial users, customers and food-business owners who need the right Zipla POS support route.</p>
          <div class="zi-faq-narrow"><FaqList faqs={contactFaqs} heading="h3" /></div>
        </div>
      </section>

      <section class="zb-sec">
        <div class="zb-wrap">
          <div class="zi-read">
            <nav aria-labelledby="contact-related-title">
              <h2 id="contact-related-title" class="zb-h2">Where can you find related Zipla information?</h2>
              <p class="zb-sec-p">Read the <a href="/refund-policy/">Cancellation &amp; Refund Policy</a>, the <a href="/terms-and-conditions/">Terms and Conditions</a>, the <a href="/privacy-policy/">Privacy Policy</a>, or return to the <a href="/">Zipla POS homepage</a>.</p>
            </nav>
            <div class="zi-back">
              <a href="/" class="zi-backlink">← Back to Zipla POS</a>
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Layout>
