---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import '../index.css';

const title = 'Contact Zipla POS Support | Billing Software Help';
const description = 'Contact Zipla POS support for billing software help, subscriptions, cancellations and refund requests by email, phone or WhatsApp.';
const canonical = 'https://zipla.in/contact-us/';

const contactFaqs = [
  {
    question: 'How can I contact Zipla POS support?',
    answer: 'Contact Zipla POS support at support@zipla.in, by phone or WhatsApp at +91 7817851009, during Monday to Saturday, 10:00 AM to 7:00 PM.',
  },
  {
    question: 'What should I include in a Zipla POS support request?',
    answer: 'Include your business name, registered phone number and a short description of the issue or request. Do not send passwords, UPI PINs or payment credentials by email or WhatsApp.',
  },
  {
    question: 'How do I request a cancellation or refund?',
    answer: 'Email support@zipla.in from your registered email address. Include your business name, registered phone number, payment date and whether you want cancellation or a refund. Read the Cancellation & Refund Policy for the applicable conditions.',
  },
  {
    question: 'Can I contact Zipla POS before starting a trial?',
    answer: 'Yes. Zipla POS trial users, customers and Indian food-business owners evaluating the service can use these support contact details for product, subscription and business enquiries.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': canonical,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://zipla.in/#website' },
      about: { '@id': 'https://zipla.in/#software' },
      inLanguage: 'en-IN',
      dateModified: '2026-08-25',
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://zipla.in/' },
        { '@type': 'ListItem', position: 2, name: 'Contact Zipla POS Support', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: contactFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Header client:load />

  <main class="legal-main">
    <article class="legal-container">
      <header class="legal-header">
        <p class="legal-eyebrow">Zipla POS</p>
        <h1>Contact Zipla POS Support</h1>
        <p class="legal-meta">Last updated: <time datetime="2026-08-25">August 25, 2026</time></p>
        <p class="legal-summary"><strong>Key takeaway:</strong> Contact Zipla POS support for billing software help, subscription questions, cancellation requests or refund requests.</p>
        <p class="legal-audience"><strong>Who this is for:</strong> Zipla POS trial users, customers and Indian food-business owners evaluating the service. <strong>Use this page when:</strong> you need product, account, subscription, cancellation or refund help.</p>
      </header>

      <div class="legal-body">
        <p>A contact page gives Zipla POS users and prospective customers a direct route for product support, subscription questions, cancellations and refund requests. Use the contact details below during business hours.</p>

        <h2>How can you contact Zipla POS support?</h2>
        <p class="legal-direct-answer"><strong>Short answer:</strong> Email <a href="mailto:support@zipla.in">support@zipla.in</a>, call or WhatsApp <a href="tel:+917817851009">+91 7817851009</a>, or use the operating address below.</p>
        <div class="legal-contact">
          <dl>
            <div><dt>Business name</dt><dd>ZIPLA (Operating as Zipla POS)</dd></div>
            <div><dt>Support email</dt><dd><a href="mailto:support@zipla.in">support@zipla.in</a></dd></div>
            <div><dt>Support phone / WhatsApp</dt><dd><a href="tel:+917817851009">+91 7817851009</a></dd></div>
            <div><dt>Business hours</dt><dd>Mon - Sat (10:00 AM - 7:00 PM)</dd></div>
            <div><dt>Operating address</dt><dd><address>House no 395, Peer wali gali,<br />Rawli road, Muradnagar, Ghaziabad,<br />Uttar Pradesh - 201206</address></dd></div>
          </dl>
        </div>

        <h2>Which Zipla POS support route should you use?</h2>
        <p class="legal-direct-answer"><strong>Short answer:</strong> Choose the route that matches your request, then include enough account information for Zipla POS to identify it safely.</p>
        <div class="legal-decision">
          <h3>Support request guide</h3>
          <table>
            <thead>
              <tr><th scope="col">If you need</th><th scope="col">Contact route</th><th scope="col">Include</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Product or setup help</th><td>Email, phone or WhatsApp</td><td>Business name, registered phone number and a short description of the billing-software question.</td></tr>
              <tr><th scope="row">Subscription, cancellation or refund</th><td><a href="mailto:support@zipla.in">support@zipla.in</a></td><td>Business name, registered phone number, payment date and the request type.</td></tr>
              <tr><th scope="row">General business enquiry</th><td>Email, phone or WhatsApp</td><td>Your business name and the information you need before starting a trial.</td></tr>
            </tbody>
          </table>
        </div>

        <h2>What should you include in a support request?</h2>
        <p>Use this short checklist so Zipla POS can identify the right account or request without asking you to share sensitive credentials.</p>
        <ol>
          <li>State your business name and registered phone number.</li>
          <li>Describe the product, subscription, cancellation or refund request in a few sentences.</li>
          <li>For a payment request, include the payment date.</li>
          <li>Do not send passwords, UPI PINs or payment credentials by email or WhatsApp.</li>
        </ol>
        <div class="legal-template">
          <h3>Example support email</h3>
          <p><strong>Subject:</strong> Help with my Zipla POS account<br />
          <strong>Include:</strong> business name, registered phone number, the request type and a short description of the issue. For a subscription, cancellation or refund request, also include the payment date.</p>
        </div>

        <h2>Need to cancel or request a refund?</h2>
        <p class="legal-direct-answer"><strong>Short answer:</strong> Send the request to <a href="mailto:support@zipla.in">support@zipla.in</a> from your registered email address, then review the applicable conditions in the <a href="/refund-policy/">Zipla POS Cancellation &amp; Refund Policy</a>.</p>
        <p>For information about the payment provider's own support process after you have contacted Zipla POS, use the official <a href="https://razorpay.com/support/" target="_blank" rel="noopener noreferrer">Razorpay Support</a> page. Zipla subscription, cancellation and refund requests should start with Zipla POS support.</p>
      </div>

      <section class="legal-faq" aria-labelledby="contact-faq-title">
        <h2 id="contact-faq-title">Zipla POS Support FAQs</h2>
        <p>Concise answers for trial users, customers and food-business owners who need the right Zipla POS support route.</p>
        <div class="legal-faq-list">
          {contactFaqs.map((faq) => (
            <section class="legal-faq-item">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </section>
          ))}
        </div>
      </section>

      <nav class="legal-related" aria-labelledby="contact-related-title">
        <h2 id="contact-related-title">Where can you find related Zipla information?</h2>
        <p>Read the <a href="/refund-policy/">Cancellation &amp; Refund Policy</a>, the <a href="/terms-and-conditions/">Terms and Conditions</a>, the <a href="/privacy-policy/">Privacy Policy</a>, or return to the <a href="/">Zipla POS homepage</a>.</p>
      </nav>

      <div class="legal-back">
        <a href="/" class="legal-back-link">← Back to Zipla POS</a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

