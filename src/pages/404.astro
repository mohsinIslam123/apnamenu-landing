---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import '../index.css';
import '../styles/business.css';
import '../styles/reading.css';
---

<Layout zp
  title="Page Not Found | Zipla POS"
  description="The page you requested is not available."
  canonical={null}
  robots="noindex"
>
  <Header client:load />

  <main class="zb-page">
    <section class="zb-wrap zr-nf" aria-labelledby="not-found-title">
      <span class="zb-eyebrow"><span class="zb-dot" aria-hidden="true"></span>404</span>
      <h1 id="not-found-title" class="zb-h1">That page is <span class="zb-hl">not available.</span></h1>
      <p class="zb-lede">The link may be old or the page may have moved. Use the homepage to explore Zipla POS or book a product demo.</p>
      <div class="zb-btnrow">
        <a class="zb-btn zb-btn-gold zb-btn-lg" href="/">Go to Zipla POS Home</a>
        <a class="zb-btn zb-btn-ghost zb-btn-lg" href="/#demo">Book Free WhatsApp Demo</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
