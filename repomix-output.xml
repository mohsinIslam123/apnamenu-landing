      "@id": "https://zipla.in/terms-and-conditions/#faq",
      "mainEntity": termsFaqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
