---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Hero from '../components/Hero.jsx';
import TrustBar from '../components/TrustBar.jsx';
import Workflow from '../components/Workflow.jsx';
import Features from '../components/Features.jsx';
import Testimonials from '../components/Testimonials.jsx';
import Pricing from '../components/Pricing.jsx';
import FAQ from '../components/FAQ.jsx';
import DemoForm from '../components/DemoForm.jsx';
import FinalCTA from '../components/FinalCTA.jsx';
import Footer from '../components/Footer.jsx';
import '../index.css';

// Add customer videos here once available:
// { id: 'uid', youtubeId: 'YT_ID', thumbnail: '/testimonials/name.jpg', name: 'Owner', business: 'Restaurant Name' }
const CUSTOMER_VIDEOS = [];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://zipla.in/#website",
      "name": "Zipla POS",
      "url": "https://zipla.in",
      "publisher": { "@id": "https://zipla.in/#organization" }
    },
    {
      "@type": "Organization",
      "@id": "https://zipla.in/#organization",
      "name": "Zipla POS",
      "url": "https://zipla.in",
      "logo": {
        "@type": "ImageObject",
        "url": "https://zipla.in/zipla-logo.webp"
      },
      "email": "support@zipla.in"
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://zipla.in/#software",
      "name": "Zipla POS",
      "url": "https://zipla.in",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web Browser",
      "description": "Restaurant POS billing software for Indian small businesses — counter billing, auto GST invoice, kitchen display, and QR table ordering.",
      "author": { "@id": "https://zipla.in/#organization" },
      "offers": [
        { "@type": "Offer", "price": "2999", "priceCurrency": "INR", "name": "Starter" },
        { "@type": "Offer", "price": "4999", "priceCurrency": "INR", "name": "Pro" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Is my data safe?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — your data is stored on secure cloud servers, accessible only through your login." } },
        { "@type": "Question", "name": "Will my staff need training?", "acceptedAnswer": { "@type": "Answer", "text": "The interface is kept simple — touch-friendly, minimal clicks. Most staff are up and running within minutes." } },
        { "@type": "Question", "name": "What if the internet goes down?", "acceptedAnswer": { "@type": "Answer", "text": "Zipla POS works after the menu is loaded — you can create bills without internet. UPI and online payments require a connection. Full offline sync is on our roadmap." } },
        { "@type": "Question", "name": "How do I add my existing menu?", "acceptedAnswer": { "@type": "Answer", "text": "Add it manually, or use AI scan to build it from a photo of your existing menu — 20 scans/year free in Starter." } },
        { "@type": "Question", "name": "How do I get support?", "acceptedAnswer": { "@type": "Answer", "text": "You talk directly to the founder on WhatsApp — no bots, no call-center queues." } }
      ]
    }
  ]
};
---

<Layout
  title="Zipla POS — Restaurant POS Billing Software for India"
  description="Restaurant POS billing software for Indian businesses — counter billing, auto GST invoice, kitchen display, QR ordering. 14-day free trial, no card required."
  canonical="https://zipla.in"
  jsonLd={jsonLd}
>
  <Header client:load />
  <main>
    <Hero />
    <TrustBar />
    <Workflow />
    <Features />
    <Testimonials videos={CUSTOMER_VIDEOS} client:visible />
    <Pricing />
    <FAQ />
    <DemoForm client:visible />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
