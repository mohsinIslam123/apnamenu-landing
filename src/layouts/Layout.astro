---
interface Props {
  title?: string;
  description?: string;
  canonical?: string | null;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
  jsonLd?: object;
}

const {
  title = 'Zipla POS — Restaurant POS Billing Software for India',
  description = 'Restaurant POS billing software for India — counter billing, GST invoices, kitchen display and QR ordering. 14-day free trial, no card required.',
  canonical = 'https://zipla.in/',
  ogImage = 'https://zipla.in/og-image.jpg',
  ogImageAlt = 'Zipla POS logo on a dark background',
  robots,
  jsonLd,
} = Astro.props;

const globalGraph = [
  {
    "@type": "WebSite",
    "@id": "https://zipla.in/#website",
    "name": "Zipla POS",
    "url": "https://zipla.in/",
    "publisher": { "@id": "https://zipla.in/#organization" }
  },
  {
    "@type": "Organization",
    "@id": "https://zipla.in/#organization",
    "name": "Zipla POS",
    "url": "https://zipla.in/",
    "logo": { "@type": "ImageObject", "url": "https://zipla.in/zipla-logo.webp" },
    "email": "support@zipla.in",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": "support@zipla.in",
      "telephone": "+91 7817851009"
    }
  },
  {
    "@type": "SoftwareApplication",
    "@id": "https://zipla.in/#software",
    "name": "Zipla POS",
    "url": "https://zipla.in/",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web Browser",
    "description": "Restaurant POS billing software for Indian small businesses — counter billing, auto GST invoice, kitchen display, and QR table ordering.",
    "author": { "@id": "https://zipla.in/#organization" },
    "offers": [
      { "@type": "Offer", "price": "2999", "priceCurrency": "INR", "name": "Starter" },
      { "@type": "Offer", "price": "4999", "priceCurrency": "INR", "name": "Pro" }
    ]
  }
];

type JsonLdWithGraph = { "@graph"?: object[] };

const pageJsonLd = jsonLd as JsonLdWithGraph | undefined;
const pageGraph = Array.isArray(pageJsonLd?.["@graph"])
  ? pageJsonLd["@graph"]
  : jsonLd
    ? [jsonLd]
    : [];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [...globalGraph, ...pageGraph]
};

// GA4 Measurement ID — zipla.in
const GA_ID = 'G-48WXKXR3F1';
---
<!DOCTYPE html>
<html lang="en-IN" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}

  {canonical && (
    <>
      <!-- Open Graph -->
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:type" content="website" />
      <meta property="og:url" content={canonical} />
      <meta property="og:site_name" content="Zipla POS" />
      <meta property="og:locale" content="en_IN" />
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:alt" content={ogImageAlt} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />

      <!-- Twitter -->
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={ogImage} />
      <meta name="twitter:image:alt" content={ogImageAlt} />

      <link rel="canonical" href={canonical} />
    </>
  )}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('zipla-theme');
      const theme = savedTheme === 'light' ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    } catch {
      document.documentElement.dataset.theme = 'dark';
      document.documentElement.style.colorScheme = 'dark';
    }
  </script>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />


  <!-- Self-hosted fonts prevent external font swaps after first paint. -->
  <link rel="preload" href="/fonts/syne-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <slot />
  <aside id="zipla-consent-banner" class="zipla-consent-banner" role="dialog" aria-labelledby="zipla-consent-title" aria-describedby="zipla-consent-copy" hidden>
    <h2 id="zipla-consent-title">Help us improve Zipla.in</h2>
    <p id="zipla-consent-copy">We use optional analytics to understand visits and improve this site. You can allow or reject analytics. Read our <a href="/privacy-policy/">Privacy Policy</a>.</p>
    <div class="zipla-consent-actions">
      <button type="button" class="zipla-consent-button zipla-consent-button--reject" data-zipla-consent="reject">Reject analytics</button>
      <button type="button" class="zipla-consent-button zipla-consent-button--manage" data-zipla-consent="manage">Manage</button>
      <button type="button" class="zipla-consent-button zipla-consent-button--accept" data-zipla-consent="accept">Allow analytics</button>
    </div>
  </aside>
  <aside id="zipla-consent-preferences" class="zipla-consent-banner zipla-consent-preferences" role="dialog" aria-labelledby="zipla-preferences-title" hidden>
    <h2 id="zipla-preferences-title">Privacy settings</h2>
    <p>Analytics is optional. Choose whether Zipla.in may use GA4 analytics cookies.</p>
    <div class="zipla-consent-actions">
      <button type="button" class="zipla-consent-button zipla-consent-button--reject" data-zipla-consent="reject">Reject analytics</button>
      <button type="button" class="zipla-consent-button zipla-consent-button--accept" data-zipla-consent="accept">Allow analytics</button>
    </div>
  </aside>
  <script is:inline define:vars={{ GA_ID }}>
    (function () {
      const CONSENT_KEY = 'zipla-analytics-consent';
      const consentBanner = document.getElementById('zipla-consent-banner');
      const consentPreferences = document.getElementById('zipla-consent-preferences');

      function getSavedConsent() {
        try {
          return window.localStorage.getItem(CONSENT_KEY);
        } catch (error) {
          return null;
        }
      }

      let consentState = getSavedConsent();

      function setConsent(value) {
        consentState = value;
        try {
          window.localStorage.setItem(CONSENT_KEY, value);
        } catch (error) {
          // Continue for this page if storage is unavailable.
        }
      }

      function setVisible(element, visible) {
        if (element) element.hidden = !visible;
      }

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });

      function updateAnalyticsConsent(granted) {
        window.gtag('consent', 'update', {
          analytics_storage: granted ? 'granted' : 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
      }

      function loadAnalytics() {
        if (window.__ziplaAnalyticsLoaded) {
          updateAnalyticsConsent(true);
          return;
        }

        updateAnalyticsConsent(true);
        window.gtag('js', new Date());
        window.gtag('config', GA_ID);

        const analyticsScript = document.createElement('script');
        analyticsScript.async = true;
        analyticsScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(analyticsScript);
        window.__ziplaAnalyticsLoaded = true;
      }

      window.ziplaTrack = function (eventName, parameters) {
        if (consentState !== 'granted' || typeof window.gtag !== 'function') return;
        window.gtag('event', eventName, parameters || {});
      };

      function hideConsent() {
        setVisible(consentBanner, false);
        setVisible(consentPreferences, false);
      }

      function showPreferences() {
        setVisible(consentBanner, false);
        setVisible(consentPreferences, true);
        const focusTarget = consentPreferences && consentPreferences.querySelector('button');
        if (focusTarget) focusTarget.focus();
      }

      function saveConsent(granted) {
        setConsent(granted ? 'granted' : 'denied');
        if (granted) loadAnalytics();
        else updateAnalyticsConsent(false);
        hideConsent();
      }

      document.addEventListener('click', function (event) {
        const element = event.target instanceof Element ? event.target : null;
        const consentControl = element && element.closest('[data-zipla-consent]');
        if (consentControl) {
          const action = consentControl.getAttribute('data-zipla-consent');
          if (action === 'accept') saveConsent(true);
          if (action === 'reject') saveConsent(false);
          if (action === 'manage') showPreferences();
          return;
        }

        const settingsButton = element && element.closest('#zipla-consent-settings');
        if (settingsButton) {
          showPreferences();
          return;
        }

        const link = element && element.closest('a');
        if (!link) return;
        const href = link.getAttribute('href') || '';

        if (href.indexOf('https://app.zipla.in/register') === 0) {
          const ctaLocation = link.closest('.site-header') ? 'header'
            : link.closest('.pricing') ? 'pricing'
            : link.closest('.final-cta') ? 'final_cta'
            : 'page';
          window.ziplaTrack('trial_click', { cta_location: ctaLocation });
          return;
        }

        if (href.indexOf('#demo') !== -1) {
          window.ziplaTrack('demo_cta_click');
          return;
        }

        if (href.indexOf('https://wa.me/') === 0) {
          window.ziplaTrack('whatsapp_click');
        }
      });

      if (consentState === 'granted') {
        loadAnalytics();
      } else if (!consentState) {
        setVisible(consentBanner, true);
      }
    }());
  </script>
</body>
</html>
