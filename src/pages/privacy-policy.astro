---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import '../index.css';

const title = "Privacy Policy — Zipla POS";
const description = "Privacy Policy for Zipla POS. Learn how we collect, use, and protect your data. Zipla is committed to your privacy.";
const canonical = "https://zipla.in/privacy-policy/";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://zipla.in/privacy-policy/",
      "url": "https://zipla.in/privacy-policy/",
      "name": "Privacy Policy — Zipla POS",
      "description": "Privacy Policy for Zipla POS billing software.",
      "isPartOf": { "@id": "https://zipla.in/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://zipla.in" },
          { "@type": "ListItem", "position": 2, "name": "Privacy Policy", "item": "https://zipla.in/privacy-policy/" }
        ]
      }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Header client:load />

  <main class="legal-main">
    <div class="legal-container">

      <div class="legal-header">
        <p class="legal-eyebrow">Zipla POS</p>
        <h1>Privacy Policy</h1>
        <p class="legal-meta">Last updated: August 13, 2026 &nbsp;|&nbsp; Effective: August 13, 2026</p>
      </div>

      <div class="legal-body">

        <p>Zipla ("we", "us", "our") operates <strong>Zipla POS</strong> — a cloud-based billing and point-of-sale software accessible at <a href="https://app.zipla.in">app.zipla.in</a> and via our Android application. This Privacy Policy explains what data we collect, how we use it, and your rights as a user.</p>

        <p>By using Zipla POS, you agree to the practices described in this policy. If you do not agree, please discontinue use of our services.</p>

        <h2>1. Information We Collect</h2>

        <h3>a) Account Information</h3>
        <p>When you register for Zipla POS, we collect:</p>
        <ul>
          <li>Name of business owner or authorized person</li>
          <li>Business name and type (restaurant, cafe, sweet shop, etc.)</li>
          <li>Email address</li>
          <li>Phone number</li>
          <li>Password (stored in encrypted form — never readable by us)</li>
        </ul>

        <h3>b) Business Data</h3>
        <p>To operate the POS software, we store data you enter:</p>
        <ul>
          <li>Menu items, categories, and prices</li>
          <li>Bills and transaction records</li>
          <li>Customer names and contact info (if you add them to bills)</li>
          <li>Staff accounts and login activity</li>
          <li>Day close reports and daily sales summaries</li>
          <li>Stock and inventory entries</li>
          <li>KDS (Kitchen Display System) orders</li>
          <li>Petty cash entries</li>
        </ul>

        <h3>c) Payment Information</h3>
        <p>When you subscribe to Zipla POS, payments are processed through <strong>Razorpay</strong>. We do not store your credit/debit card numbers or UPI credentials. Razorpay processes all payment data under their own privacy policy and PCI-DSS compliance.</p>

        <h3>d) Usage Data</h3>
        <p>We automatically collect basic usage information including:</p>
        <ul>
          <li>Device type and browser/app version</li>
          <li>IP address and approximate location</li>
          <li>Pages visited and features used within the app</li>
          <li>Error logs and crash reports</li>
        </ul>
        <p>This data is used to improve the product and fix bugs — not for advertising.</p>

        <h3>e) Analytics</h3>
        <p>Our landing page (zipla.in) uses <strong>Google Analytics 4 (GA4)</strong> to understand visitor traffic, page views, and referral sources. GA4 uses cookies and may collect anonymized identifiers. You can opt out via <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google's opt-out tool</a>.</p>

        <h2>2. How We Use Your Information</h2>
        <ul>
          <li><strong>To provide the service:</strong> All business data you enter is used solely to operate your POS account — billing, reports, KDS, and related features.</li>
          <li><strong>To send important communications:</strong> Account setup confirmation, subscription renewal reminders, and critical service updates via email.</li>
          <li><strong>To process payments:</strong> Subscription fees via Razorpay.</li>
          <li><strong>To improve the product:</strong> Usage patterns and error logs help us fix bugs and build better features.</li>
          <li><strong>To provide customer support:</strong> When you contact us, we use your account information to assist you.</li>
        </ul>
        <p>We do <strong>not</strong> sell your data to any third party. We do not use your business data for advertising. We do not share your customer data with any other business.</p>

        <h2>3. Data Storage and Security</h2>
        <p>Your data is stored on <strong>Supabase</strong> infrastructure (PostgreSQL database hosted on AWS), with servers located in India or Singapore depending on availability. Supabase is SOC 2 Type II compliant.</p>
        <p>We apply the following security measures:</p>
        <ul>
          <li>Passwords are hashed using bcrypt — never stored in plain text</li>
          <li>All data transmission uses HTTPS/TLS encryption</li>
          <li>Database access is restricted to authenticated Edge Functions only</li>
          <li>Row-Level Security (RLS) ensures each tenant can only access their own data</li>
        </ul>
        <p>No security system is 100% foolproof. If we become aware of a data breach that affects your account, we will notify you via email within 72 hours.</p>

        <h2>4. Data Retention</h2>
        <p>We retain your account and business data for as long as your account is active. If you request account deletion, we will permanently delete all your data within 30 days, except where required by law to retain records (e.g., payment receipts for tax compliance — retained for 7 years as per Indian financial regulations).</p>

        <h2>5. Third-Party Services</h2>
        <p>Zipla POS uses the following third-party services. Each has its own privacy policy:</p>
        <ul>
          <li><strong>Supabase</strong> — Database and authentication infrastructure. <a href="https://supabase.com/privacy" target="_blank" rel="noopener">Privacy Policy</a></li>
          <li><strong>Razorpay</strong> — Payment processing. <a href="https://razorpay.com/privacy/" target="_blank" rel="noopener">Privacy Policy</a></li>
          <li><strong>Google Analytics 4</strong> — Website analytics (landing page only). <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Privacy Policy</a></li>
          <li><strong>Cloudflare</strong> — Hosting and CDN. <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener">Privacy Policy</a></li>
        </ul>

        <h2>6. Cookies</h2>
        <p>Zipla POS app uses session tokens stored in your browser's local storage to keep you logged in. We do not use tracking cookies inside the app. Our landing page (zipla.in) uses Google Analytics cookies for traffic analysis only.</p>

        <h2>7. Children's Privacy</h2>
        <p>Zipla POS is a business software tool intended for adults (18 years or older). We do not knowingly collect personal data from anyone under the age of 18. If we discover that a child's data has been submitted, we will delete it immediately.</p>

        <h2>8. Your Rights</h2>
        <p>As a user of Zipla POS, you have the right to:</p>
        <ul>
          <li><strong>Access:</strong> Request a copy of the personal data we hold about you</li>
          <li><strong>Correction:</strong> Request correction of any incorrect data</li>
          <li><strong>Deletion:</strong> Request deletion of your account and all associated data</li>
          <li><strong>Portability:</strong> Request your business data (menu, bills, reports) exported in a readable format</li>
          <li><strong>Withdraw consent:</strong> Stop using the service at any time</li>
        </ul>
        <p>To exercise any of these rights, email us at <a href="mailto:support@zipla.in">support@zipla.in</a>. We will respond within 15 working days.</p>

        <h2>9. Changes to This Policy</h2>
        <p>We may update this Privacy Policy from time to time. When we do, we will update the "Last updated" date at the top of this page. For significant changes, we will send an email notification to all registered users. Continued use of Zipla POS after changes means you accept the updated policy.</p>

        <h2>10. Governing Law</h2>
        <p>This Privacy Policy is governed by the laws of India. Any disputes shall be subject to the exclusive jurisdiction of the courts in Uttar Pradesh, India.</p>

        <h2>11. Contact Us</h2>
        <p>For any privacy-related questions, data requests, or concerns:</p>
        <div class="legal-contact">
          <p><strong>Zipla POS</strong><br />
          Uttar Pradesh, India<br />
          Email: <a href="mailto:support@zipla.in">support@zipla.in</a></p>
        </div>

      </div>

      <div class="legal-back">
        <a href="/" class="legal-back-link">← Back to Zipla POS</a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .legal-main { background: #0D0D0D; min-height: 100vh; padding: 5rem 1.5rem 6rem; }
  .legal-container { max-width: 760px; margin: 0 auto; }
  .legal-header { margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #1e1e1e; }
  .legal-eyebrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #C9A94B; margin-bottom: 0.75rem; }
  .legal-header h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 700; color: #ffffff; margin: 0 0 0.75rem; }
  .legal-meta { font-size: 0.85rem; color: #666666; }
  .legal-body { color: #cccccc; font-size: 0.97rem; line-height: 1.85; }
  .legal-body > p { margin-bottom: 1.25rem; }
  .legal-body h2 { font-size: 1.2rem; font-weight: 700; color: #C9A94B; margin: 2.75rem 0 0.875rem; }
  .legal-body h3 { font-size: 1rem; font-weight: 600; color: #ffffff; margin: 1.5rem 0 0.5rem; }
  .legal-body ul, .legal-body ol { padding-left: 1.4rem; margin-bottom: 1.25rem; }
  .legal-body li { margin-bottom: 0.5rem; }
  .legal-body a { color: #C9A94B; text-decoration: underline; text-underline-offset: 3px; }
  .legal-body a:hover { opacity: 0.8; }
  .legal-body strong { color: #ffffff; font-weight: 600; }
  .legal-contact { background: #111111; border: 1px solid #1e1e1e; border-radius: 8px; padding: 1.25rem 1.5rem; margin-top: 0.5rem; }
  .legal-contact p { margin: 0; line-height: 1.8; }
  .legal-back { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #1e1e1e; }
  .legal-back-link { color: #C9A94B; text-decoration: none; font-size: 0.9rem; font-weight: 600; }
  .legal-back-link:hover { opacity: 0.8; }
</style>
