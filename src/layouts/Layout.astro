---
interface Props {
  title?: string;
  description?: string;
  canonical?: string | null;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
  jsonLd?: object;
}

const {
  title = 'Complete Restaurant Billing Software for India | Zipla POS',
  description = 'Complete restaurant billing and ordering software for growing restaurants, cafes, bakeries, QSRs and dhabas.',
  canonical = 'https://zipla.in/',
  ogImage = 'https://zipla.in/og-image.jpg',
  ogImageAlt = 'Zipla POS logo on a dark background',
  robots,
  jsonLd,
} = Astro.props;

const globalGraph = [
  {
    "@type": "WebSite",
    "@id": "https://zipla.in/#website",
    "name": "Zipla POS",
    "url": "https://zipla.in/",
    "publisher": { "@id": "https://zipla.in/#organization" }
  },
  {
    "@type": "Organization",
    "@id": "https://zipla.in/#organization",
    "name": "Zipla POS",
    "url": "https://zipla.in/",
    "logo": { "@type": "ImageObject", "url": "https://zipla.in/zipla-logo.webp" },
    "email": "support@zipla.in",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": "support@zipla.in",
      "telephone": "+91 7817851009"
    }
  },
  {
    "@type": "SoftwareApplication",
    "@id": "https://zipla.in/#software",
    "name": "Zipla POS",
    "url": "https://zipla.in/",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web Browser",
    "description": "Complete restaurant billing and ordering software for growing restaurants, cafes, bakeries, QSRs and dhabas, with table and customer QR ordering and live order status tracking.",
    "author": { "@id": "https://zipla.in/#organization" },
    "offers": [
      { "@type": "Offer", "price": "4999", "priceCurrency": "INR", "name": "Complete plan", "description": "Annual subscription" },
      { "@type": "Offer", "price": "11999", "priceCurrency": "INR", "name": "Complete plan — 3-year prepaid term", "description": "Three-year prepaid subscription term" }
    ]
  }
];

type JsonLdWithGraph = { "@graph"?: object[] };

const pageJsonLd = jsonLd as JsonLdWithGraph | undefined;
const pageGraph = Array.isArray(pageJsonLd?.["@graph"])
  ? pageJsonLd["@graph"]
  : jsonLd
    ? [jsonLd]
    : [];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [...globalGraph, ...pageGraph]
};

// GA4 Measurement ID — zipla.in
const GA_ID = 'G-48WXKXR3F1';
---
<!DOCTYPE html>
<html lang="en-IN" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}

  {canonical && (
    <>
      <!-- Open Graph -->
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:type" content="website" />
      <meta property="og:url" content={canonical} />
      <meta property="og:site_name" content="Zipla POS" />
      <meta property="og:locale" content="en_IN" />
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:alt" content={ogImageAlt} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />

      <!-- Twitter -->
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={ogImage} />
      <meta name="twitter:image:alt" content={ogImageAlt} />

      <link rel="canonical" href={canonical} />
    </>
  )}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('zipla-theme');
      const theme = savedTheme === 'light' ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    } catch {
      document.documentElement.dataset.theme = 'dark';
      document.documentElement.style.colorScheme = 'dark';
    }
  </script>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />


  <!-- Self-hosted fonts prevent external font swaps after first paint. -->
  <link rel="preload" href="/fonts/syne-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <slot />
  <aside id="zipla-consent-banner" class="zipla-consent-banner" role="dialog" aria-modal="true" aria-labelledby="zipla-consent-title" aria-describedby="zipla-consent-copy" tabindex="-1" hidden>
    <h2 id="zipla-consent-title">Help us improve Zipla.in</h2>
    <p id="zipla-consent-copy">We use optional analytics to understand visits and improve this site. You can allow or reject analytics. Read our <a href="/privacy-policy/">Privacy Policy</a>.</p>
    <div class="zipla-consent-actions">
      <button type="button" class="zipla-consent-button zipla-consent-button--reject" data-zipla-consent="reject">Reject analytics</button>
      <button type="button" class="zipla-consent-button zipla-consent-button--manage" data-zipla-consent="manage">Manage</button>
      <button type="button" class="zipla-consent-button zipla-consent-button--accept" data-zipla-consent="accept">Allow analytics</button>
    </div>
  </aside>
  <aside id="zipla-consent-preferences" class="zipla-consent-banner zipla-consent-preferences" role="dialog" aria-modal="true" aria-labelledby="zipla-preferences-title" aria-describedby="zipla-preferences-copy" tabindex="-1" hidden>
    <h2 id="zipla-preferences-title">Privacy settings</h2>
    <p id="zipla-preferences-copy">Analytics is optional. Choose whether Zipla.in may use GA4 analytics cookies.</p>
    <div class="zipla-consent-actions">
      <button type="button" class="zipla-consent-button zipla-consent-button--reject" data-zipla-consent="reject">Reject analytics</button>
      <button type="button" class="zipla-consent-button zipla-consent-button--accept" data-zipla-consent="accept">Allow analytics</button>
    </div>
  </aside>
  <script is:inline define:vars={{ GA_ID }}>
    (function () {
      const CONSENT_KEY = 'zipla-analytics-consent';
      const host = window.location.hostname;
      const sharedCookieDomain = host === 'zipla.in' || host === 'www.zipla.in'
        ? ' Domain=zipla.in;'
        : '';
      const consentBanner = document.getElementById('zipla-consent-banner');
      const consentPreferences = document.getElementById('zipla-consent-preferences');
      let activeDialog = null;
      let lastFocusedElement = null;

      function setConsentCookie(value) {
        document.cookie = CONSENT_KEY + '=' + encodeURIComponent(value)
          + '; Max-Age=31536000; Path=/; SameSite=Lax;'
          + (window.location.protocol === 'https:' ? ' Secure;' : '')
          + sharedCookieDomain;
      }

      function getSavedConsent() {
        const cookieMatch = document.cookie.match(/(?:^|;\s*)zipla-analytics-consent=([^;]+)/);
        if (cookieMatch) {
          try {
            return decodeURIComponent(cookieMatch[1]);
          } catch (error) {
            return null;
          }
        }

        try {
          const storedConsent = window.localStorage.getItem(CONSENT_KEY);
          if (storedConsent) {
            setConsentCookie(storedConsent);
            return storedConsent;
          }
        } catch (error) {
          return null;
        }

        return null;
      }

      let consentState = getSavedConsent();

      function setConsent(value) {
        consentState = value;
        setConsentCookie(value);
        try {
          window.localStorage.setItem(CONSENT_KEY, value);
        } catch (error) {
          // Continue for this page if storage is unavailable.
        }
      }

      function setVisible(element, visible) {
        if (element) element.hidden = !visible;
      }

      function rememberFocusedElement() {
        const current = document.activeElement;
        if (current && current !== document.body) lastFocusedElement = current;
      }

      function getFocusableElements(dialog) {
        if (!dialog) return [];
        return Array.from(dialog.querySelectorAll('button, a[href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
          .filter((element) => !element.disabled && !element.hidden);
      }

      function focusDialog(dialog) {
        activeDialog = dialog;
        const focusTarget = getFocusableElements(dialog)[0] || dialog;
        if (focusTarget) focusTarget.focus();
      }

      function restoreFocus() {
        const focusTarget = lastFocusedElement;
        lastFocusedElement = null;
        if (focusTarget && focusTarget.isConnected && typeof focusTarget.focus === 'function') {
          focusTarget.focus();
        }
      }

      function clearAnalyticsCookies() {
        const cookieNames = document.cookie
          .split(';')
          .map((cookie) => cookie.trim().split('=')[0])
          .filter((name) => /^_(ga|gid|gat|gac_)/.test(name));

        const domains = [null];
        if (host === 'zipla.in' || host === 'www.zipla.in') domains.push('zipla.in');

        cookieNames.forEach((name) => {
          domains.forEach((domain) => {
            const domainPart = domain ? ' Domain=' + domain + ';' : '';
            document.cookie = name + '=; Max-Age=0; Path=/; SameSite=Lax;'
              + (window.location.protocol === 'https:' ? ' Secure;' : '')
              + domainPart;
          });
        });
      }

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });

      function updateAnalyticsConsent(granted) {
        window.gtag('consent', 'update', {
          analytics_storage: granted ? 'granted' : 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
      }

      function loadAnalytics() {
        if (window.__ziplaAnalyticsLoaded) {
          updateAnalyticsConsent(true);
          return;
        }

        updateAnalyticsConsent(true);
        window.gtag('js', new Date());
        window.gtag('config', GA_ID);

        const analyticsScript = document.createElement('script');
        analyticsScript.async = true;
        analyticsScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(analyticsScript);
        window.__ziplaAnalyticsLoaded = true;
      }

      window.ziplaTrack = function (eventName, parameters) {
        if (consentState !== 'granted' || typeof window.gtag !== 'function') return;
        window.gtag('event', eventName, parameters || {});
      };

      function hideConsent() {
        setVisible(consentBanner, false);
        setVisible(consentPreferences, false);
        activeDialog = null;
        restoreFocus();
      }

      function showBanner() {
        rememberFocusedElement();
        setVisible(consentPreferences, false);
        setVisible(consentBanner, true);
        focusDialog(consentBanner);
      }

      function showPreferences() {
        rememberFocusedElement();
        setVisible(consentBanner, false);
        setVisible(consentPreferences, true);
        focusDialog(consentPreferences);
      }

      function saveConsent(granted) {
        setConsent(granted ? 'granted' : 'denied');
        if (granted) loadAnalytics();
        else {
          updateAnalyticsConsent(false);
          clearAnalyticsCookies();
        }
        hideConsent();
      }

      document.addEventListener('click', function (event) {
        const element = event.target instanceof Element ? event.target : null;
        const consentControl = element && element.closest('[data-zipla-consent]');
        if (consentControl) {
          const action = consentControl.getAttribute('data-zipla-consent');
          if (action === 'accept') saveConsent(true);
          if (action === 'reject') saveConsent(false);
          if (action === 'manage') showPreferences();
          return;
        }

        const settingsButton = element && element.closest('#zipla-consent-settings');
        if (settingsButton) {
          showPreferences();
          return;
        }

        const link = element && element.closest('a');
        if (!link) return;
        const href = link.getAttribute('href') || '';

        if (href.indexOf('https://app.zipla.in/register') === 0) {
          const ctaLocation = link.closest('.site-header') ? 'header'
            : link.closest('.pricing') ? 'pricing'
            : link.closest('.final-cta') ? 'final_cta'
            : 'page';
          window.ziplaTrack('trial_click', { cta_location: ctaLocation });
          return;
        }

        if (href.indexOf('#demo') !== -1) {
          window.ziplaTrack('demo_cta_click');
          return;
        }

        if (href.indexOf('https://wa.me/') === 0) {
          window.ziplaTrack('whatsapp_click');
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          if (activeDialog === consentPreferences) {
            if (consentState) hideConsent();
            else showBanner();
            event.preventDefault();
          } else if (activeDialog === consentBanner) {
            if (!consentState) {
              const rejectButton = consentBanner.querySelector('[data-zipla-consent="reject"]');
              if (rejectButton) rejectButton.focus();
              event.preventDefault();
            } else {
              hideConsent();
            }
          }
          return;
        }

        if (event.key !== 'Tab' || !activeDialog) return;
        const focusable = getFocusableElements(activeDialog);
        if (!focusable.length) {
          event.preventDefault();
          activeDialog.focus();
          return;
        }

        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      if (consentState === 'granted') {
        loadAnalytics();
      } else if (!consentState) {
        showBanner();
      }
    }());
  </script>
</body>
</html>
