<file path="src/pages/cafe-pos-software.astro">
---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import '../index.css';
import '../vertical-page.css';

const title = 'Cafe POS Billing Software for India | QR & KDS | Zipla POS';
const description = 'Cafe POS Billing Software for India lets counter and table-service cafés manage GST invoices, QR ordering, KDS, payment tracking and day-close reports.';
const canonical = 'https://zipla.in/cafe-pos-software/';

const faqs = [
  {
    question: 'Can Zipla POS handle both walk-in counter bills and table QR orders?',
    answer: 'Yes. Staff can create counter bills for walk-in customers while diners can use table QR ordering. Both are part of the same Zipla POS workflow and can be reviewed in day-close reporting.',
  },
  {
    question: 'Does Zipla POS work on an Android phone or tablet at a café counter?',
    answer: 'Yes. Zipla POS can be used on Android phones and tablets. You can also pair a supported Bluetooth thermal printer when you want printed bills.',
  },
  {
    question: 'What does Starter versus Pro include for a café?',
    answer: 'Starter includes counter billing, GST invoices, inventory with low-stock alerts, cash/UPI/card payments and staff roles. Pro includes everything in Starter plus Kitchen Display System, table QR ordering, Bluetooth KOT auto-print, sales analytics and day-close reports.',
  },
  {
    question: 'What happens if the internet connection drops during café service?',
    answer: 'After the menu has loaded, you can create bills without an internet connection. UPI and online payments require connectivity. Full offline sync is on the roadmap.',
  },
  {
    question: 'Can a café print or share a bill with the customer?',
    answer: 'Yes. Use a supported Bluetooth thermal printer for printed bills, or share a bill on WhatsApp when a digital copy is more useful for the customer.',
  },
  {
    question: 'How is Zipla POS priced for a café?',
    answer: 'Starter is ₹2,999 per year or ₹5,999 for three years. Pro is ₹4,999 per year or ₹9,899 for three years. Zipla uses a flat annual fee with no per-transaction, per-item, per-device or AMC charges.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://zipla.in/#website' },
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://zipla.in/' },
        { '@type': 'ListItem', position: 2, name: 'Cafe POS Software', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

