  { question: "What are the current Zipla POS plan prices?", answer: "Starter is ₹2,999 per year or ₹5,999 for three years. Pro is ₹4,999 per year or ₹9,899 for three years." },
  { question: "What does the Terms refund policy say?", answer: "These Terms state a 7-day refund window for annual subscriptions, subject to the conditions listed in the Refund Policy section." },
  { question: "How can I stop using Zipla POS or request account deletion?", answer: "You may stop using Zipla POS at any time. To request account and data deletion, email support@zipla.in as stated in these Terms." },
  { question: "Where can I read Zipla POS privacy practices?", answer: "Read the Zipla POS Privacy Policy, which these Terms incorporate by reference for the collection and use of personal data." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://zipla.in/terms-and-conditions/",
      "url": "https://zipla.in/terms-and-conditions/",
      "name": title,
      "description": description,
      "isPartOf": { "@id": "https://zipla.in/#website" },
