---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import MachineBandS from '../components/MachineBandS.jsx';
import FaqList from '../components/FaqList.jsx';
import '../index.css';
import '../styles/machine.css';
import '../styles/machine-s.css';
import '../styles/business.css';
import '../styles/inner.css';
import '../styles/reading.css';

const title = "Privacy Policy for Zipla POS Users in India";
const description = "Read the Zipla POS Privacy Policy for users of our website and restaurant billing software in India, including data collection, use, rights and contact details.";
const canonical = "https://zipla.in/privacy-policy/";

const privacyFaqs = [
  { question: "What information does this Privacy Policy cover?", answer: "This policy describes account, business, payment, usage and website-analytics information listed on this page." },
  { question: "How can I make a privacy request to Zipla POS?", answer: "Email support@zipla.in for an access, correction, deletion or portability request. We will review the request and reply." },
  { question: "Does this policy name third-party services?", answer: "Yes. It names Supabase, Razorpay, Google Analytics 4, Cloudflare and WhatsApp, and links to relevant provider privacy policies." },
  { question: "Where can I read related Zipla service terms?", answer: "Read the Zipla Terms and Conditions for service, subscription, acceptable-use and related legal terms." },
  { question: "How will changes to this Privacy Policy be communicated?", answer: "This policy says that the Last updated date will change when the policy is updated." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://zipla.in/privacy-policy/",
      "url": "https://zipla.in/privacy-policy/",
      "name": title,
      "description": description,
      "isPartOf": { "@id": "https://zipla.in/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://zipla.in/" },
          { "@type": "ListItem", "position": 2, "name": "Privacy Policy", "item": "https://zipla.in/privacy-policy/" }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://zipla.in/privacy-policy/#faq",
      "mainEntity": privacyFaqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    }
  ]
};
---

<Layout zp title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Header client:load />

  <main class="zb-page">
    <MachineBandS />

    <article class="zb-wrap zr-body zr-body--top">
      <div class="zr-read">
        <p class="zb-eyebrow"><span class="zb-dot" aria-hidden="true"></span>Zipla POS</p>
        <h1 class="zb-h1 zr-h1">Zipla POS <span class="zb-hl">Privacy Policy</span></h1>
        <p class="zi-dateline">Last updated: August 13, 2026 &nbsp;|&nbsp; Effective: August 13, 2026</p>
        <p><strong>Key takeaway:</strong> This Privacy Policy explains the data collection, use, storage, rights and contact practices described for Zipla POS.</p>
        <p><strong>Who this is for:</strong> people who visit zipla.in, register for or use Zipla POS, or contact Zipla about an account. <strong>Use this policy when:</strong> you want to understand the data practices and privacy-request process described for the service.</p>

        <p>Zipla ("we", "us", "our") operates <strong>Zipla POS</strong> — billing and point-of-sale software accessible at <a href="https://app.zipla.in">app.zipla.in</a> and via our Android application. This Privacy Policy explains what data we collect, how we use it, and your rights as a user.</p>

        <p>By using Zipla POS, you agree to the practices described in this policy. If you do not agree, please discontinue use of our services.</p>

        <h2>What information does Zipla POS collect?</h2>
        <p><strong>Short answer:</strong> This policy describes account, business, payment, usage and website-analytics information used to operate and support the service.</p>

        <h3>a) Account Information</h3>
        <p>When you register for Zipla POS, we collect:</p>
        <ul>
          <li>Name of business owner or authorized person</li>
          <li>Business name and type (restaurant, cafe, sweet shop, etc.)</li>
          <li>Email address</li>
          <li>Phone number</li>
          <li>Password</li>
        </ul>

        <h3>b) Business Data</h3>
        <p>To operate the POS software, we store data you enter:</p>
        <ul>
          <li>Menu items, categories, and prices</li>
          <li>Bills and transaction records</li>
          <li>Customer names and contact info (if you add them to bills)</li>
          <li>Staff accounts and login activity</li>
          <li>Day close reports and daily sales summaries</li>
          <li>Stock and inventory entries</li>
          <li>KDS (Kitchen Display System) orders</li>
          <li>Petty cash entries</li>
        </ul>

        <h3>c) Payment Information</h3>
        <p>When you subscribe to Zipla POS, payments are processed through <strong>Razorpay</strong>. We do not store your credit/debit card numbers or UPI credentials. Payment details handled in that flow are subject to Razorpay's own privacy policy.</p>

        <h3>d) Usage Data</h3>
        <p>We automatically collect basic usage information including:</p>
        <ul>
          <li>Device type and browser/app version</li>
          <li>IP address and approximate location</li>
          <li>Pages visited and features used within the app</li>
          <li>Error logs and crash reports</li>
        </ul>
        <p>This data is used to improve the product and fix bugs — not for advertising.</p>

        <h3>e) Analytics</h3>
        <p>Our landing page (zipla.in) uses optional <strong>Google Analytics 4 (GA4)</strong> only after you allow analytics through the consent controls on this site. GA4 uses cookies and may collect identifiers for visitor traffic, page views and referral sources.</p>

        <h3>f) Demo request details</h3>
        <p>When you submit the demo form, the form places your name, phone number and business type into a WhatsApp message to Zipla's demo number. WhatsApp opens the message, and you choose whether to send it.</p>

        <h2>How does Zipla POS use your information?</h2>
        <p><strong>Short answer:</strong> This policy says information is used for service delivery, account communications, payment processing, product improvement and support.</p>
        <ul>
          <li><strong>To provide the service:</strong> All business data you enter is used solely to operate your POS account — billing, reports, KDS, and related features.</li>
          <li><strong>To send important communications:</strong> Account setup confirmation, subscription renewal reminders, and critical service updates via email.</li>
          <li><strong>To process payments:</strong> Subscription fees via Razorpay.</li>
          <li><strong>To improve the product:</strong> Usage patterns and error logs help us fix bugs and build better features.</li>
          <li><strong>To provide customer support:</strong> When you contact us, we use your account information to assist you.</li>
        </ul>
        <p>We do <strong>not</strong> sell your data to any third party. We do not use your business data for advertising. We do not share your customer data with any other business.</p>

        <h2>How does Zipla POS store and protect data?</h2>
        <p><strong>Short answer:</strong> Zipla uses technical and organisational measures intended to protect information. This page does not promise a particular hosting provider, hosting region, algorithm, database configuration or compliance certification.</p>
        <p>No online system can be guaranteed completely secure. Security incidents are assessed and handled under the applicable requirements.</p>

        <h2>How long does Zipla POS retain data?</h2>
        <p><strong>Short answer:</strong> This policy says account and business data is retained while an account is active, with deletion and record-retention details described below.</p>
        <p>We may retain your account and business data while the account is active and for as long as needed for the purposes described in this policy. If you request deletion, we will review the request and applicable legal, accounting or operational obligations before confirming what can be deleted. This policy does not promise a fixed deletion timeline or retention period.</p>

        <h2>Which third-party services process or host data?</h2>
        <p><strong>Short answer:</strong> This policy names the third-party services below and links to provider policies where relevant.</p>
        <ul>
          <li><strong>Supabase</strong> — Database and authentication infrastructure. <a href="https://supabase.com/privacy" target="_blank" rel="noopener">Privacy Policy</a></li>
          <li><strong>Razorpay</strong> — Payment processing. <a href="https://razorpay.com/privacy/" target="_blank" rel="noopener">Privacy Policy</a></li>
          <li><strong>Google Analytics 4</strong> — Website analytics (landing page only). <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Privacy Policy</a></li>
          <li><strong>Cloudflare</strong> — Hosting and CDN. <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener">Privacy Policy</a></li>
          <li><strong>WhatsApp</strong> — Used when you choose to open and send a demo request or share a bill. <a href="https://www.whatsapp.com/legal/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a></li>
        </ul>

        <h2>How does Zipla POS use cookies and session storage?</h2>
        <p><strong>Short answer:</strong> This policy says the landing page stores your analytics choice in browser storage and a site cookie. GA4 analytics cookies are used only after you allow analytics. The app may use session technology needed for login and operation.</p>

        <h2>Does Zipla POS collect data from children?</h2>
        <p><strong>Short answer:</strong> This policy states that Zipla POS is intended for adults and that personal data from people under 18 is not knowingly collected.</p>
        <p>Zipla POS is a business software tool intended for adults (18 years or older). We do not knowingly collect personal data from anyone under the age of 18. If we discover that a child's data has been submitted, please email support@zipla.in so the request can be reviewed.</p>

        <h2>What privacy rights can you request?</h2>
        <p><strong>Short answer:</strong> This policy describes access, correction, deletion, portability and withdrawal-of-consent requests.</p>
        <ul>
          <li><strong>Access:</strong> Request a copy of the personal data we hold about you</li>
          <li><strong>Correction:</strong> Request correction of any incorrect data</li>
          <li><strong>Deletion:</strong> Request deletion of your account and all associated data</li>
          <li><strong>Portability:</strong> Request your business data (menu, bills, reports) exported in a readable format</li>
          <li><strong>Withdraw consent:</strong> Stop using the service at any time</li>
        </ul>
        <p>To exercise any of these rights, email us at <a href="mailto:support@zipla.in">support@zipla.in</a>. We will review the request and reply.</p>
        <div class="zr-template">
          <h3>Privacy-request email template</h3>
          <p><strong>Example:</strong> email <a href="mailto:support@zipla.in">support@zipla.in</a> with the subject “Privacy request for my Zipla POS account”, your registered account details and whether you need access, correction, deletion or portability. This is a practical template based on the request process stated in this policy.</p>
        </div>

        <h2>How will Zipla update this Privacy Policy?</h2>
        <p><strong>Short answer:</strong> This policy says the Last updated date will change when the policy changes.</p>
        <p>We may update this Privacy Policy from time to time. When we do, we will update the "Last updated" date at the top of this page. Review this page before continuing to use Zipla POS after changes.</p>

        <h2>Which law governs this Privacy Policy?</h2>
        <p><strong>Short answer:</strong> This policy states that it is governed by the laws of India and specifies the jurisdiction described below.</p>
        <p>This Privacy Policy is governed by the laws of India. Any disputes shall be subject to the exclusive jurisdiction of the courts in Uttar Pradesh, India.</p>

        <h2>How can you contact Zipla about privacy?</h2>
        <p><strong>Short answer:</strong> For privacy questions, data requests or concerns, email support@zipla.in.</p>
        <div class="zr-contact">
          <p><strong>Zipla POS</strong><br />
          Uttar Pradesh, India<br />
          Email: <a href="mailto:support@zipla.in">support@zipla.in</a></p>
        </div>

        <section aria-labelledby="privacy-faq-title">
        <h2 id="privacy-faq-title">Privacy Policy FAQs</h2>
        <p>Short answers drawn from the visible policy above for website visitors and Zipla POS account holders.</p>
          <FaqList faqs={privacyFaqs} heading="h3" />
        </section>

      <nav aria-labelledby="legal-related-title">
        <h2 id="legal-related-title">Where can you find related Zipla information?</h2>
        <p><strong>Short answer:</strong> Read the <a href="/terms-and-conditions/">Zipla Terms and Conditions</a> for service terms, use the <a href="/faq/">Zipla POS FAQ</a> for product and account answers, or return to the <a href="/">Zipla POS homepage</a>.</p>
      </nav>

      <div class="zi-back">
        <a href="/" class="zi-backlink">← Back to Zipla POS</a>
      </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
