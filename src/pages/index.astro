---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Hero from '../components/Hero.jsx';
import TrustBar from '../components/TrustBar.jsx';
import BuyerAnswer from '../components/BuyerAnswer.jsx';
import BusinessTypes from '../components/BusinessTypes.jsx';
import Workflow from '../components/Workflow.jsx';
import Features from '../components/Features.jsx';
import Testimonials from '../components/Testimonials.jsx';
import Pricing from '../components/Pricing.jsx';
import FAQ from '../components/FAQ.jsx';
import DemoForm from '../components/DemoForm.jsx';
import Footer from '../components/Footer.jsx';
import '../index.css';

const CUSTOMER_VIDEOS = [];

const PAGE_TITLE = 'Complete Restaurant Billing Software for India | Zipla POS';

const PAGE_DESCRIPTION =
  'Complete restaurant billing and ordering software for growing restaurants, cafes, bakeries, QSRs and dhabas, with Mobile POS, barcode inventory, automatic GST calculation, table and customer QR ordering, live order tracking and offline billing after the menu loads. ₹4,999/year or ₹11,999 for 3 years prepaid.';

const TOP_TAKEAWAY =
  'Zipla POS is complete restaurant billing and ordering software for growing restaurants, cafes, bakeries, QSRs and dhabas. The Complete plan includes Mobile POS, barcode scanning to add packaged products to inventory, automatic GST calculation, table and customer QR ordering, live order status tracking and offline billing after the menu loads. It costs ₹4,999/year or ₹11,999 for 3 years prepaid, with guided online setup/help and online training. Online payments require the restaurant\'s own Razorpay account and internet access.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://zipla.in/#webpage',
      url: 'https://zipla.in/',
      name: PAGE_TITLE,
      description: PAGE_DESCRIPTION,
      abstract: TOP_TAKEAWAY,
      isPartOf: { '@id': 'https://zipla.in/#website' },
      about: { '@id': 'https://zipla.in/#software' },
      breadcrumb: { '@id': 'https://zipla.in/#breadcrumb' },
      inLanguage: 'en-IN'
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://zipla.in/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://zipla.in/'
        }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://zipla.in/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How do I access my business data?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Use your Zipla login to access your business workspace.'
          }
        },
        {
          '@type': 'Question',
          name: 'Will my staff need training?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Guided online setup and online training are included. Book a demo if you want us to walk your team through the relevant workflow.'
          }
        },
        {
          '@type': 'Question',
          name: 'Can I use Zipla POS on a mobile device?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Zipla POS can be used on supported mobile devices, with staff roles for the team workflow.'
          }
        },
        {
          '@type': 'Question',
          name: 'Can barcode scanning add products to inventory?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Barcode scanning can be used to add packaged products to inventory.'
          }
        },
        {
          '@type': 'Question',
          name: 'Does Zipla POS calculate GST automatically?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. The configured GST rate is applied when the bill is generated, and GST and non-GST invoices can be printed.'
          }
        },
        {
          '@type': 'Question',
          name: 'Does Zipla POS support online payments?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Yes, when the restaurant connects its own Razorpay account. Online payments require an internet connection."
          }
        },
        {
          '@type': 'Question',
          name: 'Can customers order from home and track the order?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Customer QR Home Ordering lets customers enter their name, phone number and address, place an order from home, and track accepted, preparing and completed status on their phone.'
          }
        },
        {
          '@type': 'Question',
          name: 'Can I continue billing if the internet connection drops?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'After the menu has loaded, Zipla POS can create bills without an internet connection. UPI and online payments require connectivity. Full offline sync is on our roadmap.'
          }
        },
        {
          '@type': 'Question',
          name: 'How do I add my existing menu?',
          acceptedAnswer: {
            '@type': 'Answer',
          text: 'Use the Zipla menu-management workflow to add and review your items. Book a demo if you want help confirming the current setup process.'
          }
        },
        {
          '@type': 'Question',
          name: 'How do I get support?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'You can contact the Zipla team on WhatsApp for support and a product walkthrough.'
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  canonical="https://zipla.in/"
  jsonLd={jsonLd}
>
  <Header client:load />

  <main aria-label="Zipla POS restaurant billing software for Indian food businesses">
    <Hero takeaway={TOP_TAKEAWAY} />
    <TrustBar />
    <BuyerAnswer />
    <BusinessTypes />
    <Workflow />
    <Features />
    {CUSTOMER_VIDEOS.length > 0 && <Testimonials videos={CUSTOMER_VIDEOS} client:visible />}
    <Pricing />
    <FAQ />
    <DemoForm client:visible />
  </main>

  <Footer />
</Layout>
