---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.jsx';
import Footer from '../../components/Footer.jsx';
import '../../index.css';

const title = "Zipla POS Blog — Restaurant Billing & POS Guides for India";
const description = "Guides for Indian restaurant, dhaba, cafe, and QSR owners on GST billing, POS software, stock management, and running a food business smarter.";
const canonical = "https://zipla.in/blog/";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://zipla.in/blog/",
      "url": "https://zipla.in/blog/",
      "name": "Zipla POS Blog — Restaurant Billing & POS Guides for India",
      "description": "Guides for Indian restaurant, dhaba, cafe, and QSR owners on GST billing, POS software, and running a food business smarter.",
      "isPartOf": { "@id": "https://zipla.in/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://zipla.in" },
          { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://zipla.in/blog/" }
        ]
      }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Header client:load />

  <main class="blog-main">

    <section class="blog-hero">
      <div class="blog-container">
        <p class="blog-eyebrow">Zipla POS Blog</p>
        <h1 class="blog-h1">Restaurant Billing & POS Guides for India</h1>
        <p class="blog-lead">Practical guides for restaurant, dhaba, cafe, bakery, and QSR owners — GST billing, POS software, stock management, and more.</p>
      </div>
    </section>

    <section class="blog-list-section">
      <div class="blog-container">

        <article class="blog-card">
          <a href="/blog/bakery-billing-software-weight-billing-guide-2026/" class="blog-card-link">
            <div class="blog-card-meta">
              <span class="blog-tag">Bakery Billing</span>
              <span class="blog-date">September 1, 2026</span>
            </div>
            <h2 class="blog-card-title">Bakery Billing Software: Weight, Piece & Fixed-Price Billing Guide 2026</h2>
            <p class="blog-card-excerpt">A practical guide for bakery owners on building one clear billing flow for cakes by weight, bread by piece and fixed-price products in the same customer basket.</p>
            <span class="blog-read-more">Read Guide →</span>
          </a>
        </article>

        <article class="blog-card">
          <a href="/blog/restaurant-dhaba-gst-invoice-guide-2026/" class="blog-card-link">
            <div class="blog-card-meta">
              <span class="blog-tag">GST Billing</span>
              <span class="blog-date">August 20, 2026</span>
            </div>
            <h2 class="blog-card-title">GST Invoice for Restaurant and Dhaba in India — Step by Step Guide 2026</h2>
            <p class="blog-card-excerpt">Every GST-registered restaurant must issue compliant tax invoices — but many owners get the format, rate split, or required fields wrong. This guide covers mandatory invoice fields, GST rates for food service, common mistakes, and how billing software handles it automatically.</p>
            <span class="blog-read-more">Read Guide →</span>
          </a>
        </article>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .blog-main { background: #0D0D0D; min-height: 100vh; }
  .blog-hero { padding: 5rem 1.5rem 3rem; text-align: center; border-bottom: 1px solid #1a1a1a; }
  .blog-container { max-width: 820px; margin: 0 auto; padding: 0 1rem; }
  .blog-eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #C9A94B; margin-bottom: 1rem; }
  .blog-h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 700; color: #ffffff; line-height: 1.22; margin: 0 auto 1.25rem; }
  .blog-lead { font-size: 1.05rem; color: #aaaaaa; line-height: 1.75; max-width: 580px; margin: 0 auto; }
  .blog-list-section { padding: 3rem 1.5rem 5rem; }
  .blog-card { background: #111111; border: 1px solid #1e1e1e; border-radius: 10px; margin-bottom: 1.5rem; transition: border-color 0.18s; }
  .blog-card:hover { border-color: #C9A94B; }
  .blog-card-link { display: block; padding: 1.75rem 2rem; text-decoration: none; color: inherit; }
  .blog-card-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.875rem; }
  .blog-tag { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #C9A94B; background: rgba(201,169,75,0.1); padding: 0.2rem 0.6rem; border-radius: 4px; }
  .blog-date { font-size: 0.82rem; color: #666666; }
  .blog-card-title { font-size: 1.3rem; font-weight: 700; color: #ffffff; line-height: 1.35; margin: 0 0 0.875rem; }
  .blog-card-excerpt { font-size: 0.95rem; color: #aaaaaa; line-height: 1.75; margin: 0 0 1.25rem; }
  .blog-read-more { font-size: 0.88rem; font-weight: 600; color: #C9A94B; }
  @media (max-width: 600px) { .blog-card-link { padding: 1.25rem; } .blog-hero { padding: 3.5rem 1.25rem 2rem; } }
</style>
