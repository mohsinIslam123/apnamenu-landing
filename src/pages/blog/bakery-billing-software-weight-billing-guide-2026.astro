  .post-faq { margin-top: 0.75rem; }
  .post-faq-item { background: #111111; border: 1px solid #1e1e1e; border-radius: 8px; padding: 1.25rem 1.5rem; margin-bottom: 0.875rem; }
  .post-link { color: #C9A94B; text-decoration: underline; text-underline-offset: 3px; }
